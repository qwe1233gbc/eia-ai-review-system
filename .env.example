# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，勿提交。

# ===== 运行模式 =====
# true=离线示例(无需API, 用于演示UI)；false=调用真实模型
MOCK_MODE=true

# ===== 大模型（OpenAI 兼容 /chat/completions）=====
LLM_API_KEY=sk-请替换为你的密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-32b

# ===== Embedding =====
EMBEDDING_API_KEY=sk-请替换为你的密钥
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ===== 向量库（留空则自动定位到 03_知识库/05_检索索引_六文件）=====
VECTOR_DB_PATH=

# ===== 服务 =====
BACKEND_PORT=8000
FRONTEND_ORIGIN=*